# API (backend) base URL. Stripe webhook on backend: POST /api/webhooks/stripe (with 's')
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Server-only (SSR / generateMetadata). Set on Netlify to the same backend as previews
# (e.g. https://dev.pxispace.com) so public profile pages are not built against localhost.
# Falls back to NEXT_PUBLIC_API_BASE_URL if unset.
# API_BASE_URL=https://dev.pxispace.com

# Canonical web origin for Open Graph / profile links (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://pxispace.com

# Same public bucket origin as backend R2_PUBLIC_URL — fixes relative R2 keys in the browser if any slip through
# NEXT_PUBLIC_R2_PUBLIC_URL=https://your-r2-public-domain.com
# or VITE_API_BASE_URL if still using Vite

# Google OAuth (for login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Apple Sign-In (Services ID). MUST match backend APPLE_WEB_SERVICE_ID exactly.
NEXT_PUBLIC_APPLE_SERVICE_ID=com.example.web
# Return URL registered on that Services ID (HTTPS, no trailing slash). Required in production.
# NEXT_PUBLIC_APPLE_REDIRECT_URI=https://pxispace.com
# Falls back to NEXT_PUBLIC_SITE_URL, then window.location.origin.

# Spotify OAuth (public values only; keep SPOTIFY_CLIENT_SECRET server-side)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=https://pxispace.com/spotify-callback

# iOS: leave unset to send “App Store” CTAs to /beta (TestFlight funnel).
# Set to a full App Store URL when the app is live (e.g. https://apps.apple.com/app/...).
# NEXT_PUBLIC_IOS_APP_URL=
# Optional override for the TestFlight public invite link (defaults to join URL in appStoreLinks.js).
# NEXT_PUBLIC_TESTFLIGHT_INVITE_URL=https://testflight.apple.com/join/your-code
# No Android app yet — no NEXT_PUBLIC_ANDROID_APP_URL until one ships.

# Task 4: Edge middleware PASETO verification (same base64 as backend PASETO_PUBLIC_KEY)
NEXT_PUBLIC_PASETO_PUBLIC_KEY=base64_encoded_ed25519_public_key


# ── Analytics ────────────────────────────────────────────────────────────────
# All four are PUBLIC ids and all four are FAIL CLOSED: if an id is unset, that
# destination simply does not load. Never add a hardcoded fallback in code — a
# wrong id silently poisons a live GA4 property, which is worse than no data.
#
# NEXT_PUBLIC_GOOGLE_TAG_ID   Google tag id (GT-…). THE single loader:
#                             googletagmanager.com/gtag/js?id=<this>. Unset it
#                             and no Google tag loads at all.
# NEXT_PUBLIC_GA_MEASUREMENT_ID  GA4 web data-stream measurement id (G-…).
#                             Configured off the tag above with
#                             send_page_view:false — the app fires page_view
#                             itself, so GA4 Enhanced Measurement "history
#                             events" must stay OFF in the GA4 UI.
# NEXT_PUBLIC_GOOGLE_ADS_ID   Google Ads conversion id (AW-…). Configured
#                             explicitly so enhanced conversions can be enabled.
# NEXT_PUBLIC_GTM_ID          GTM container (GTM-…). AD PIXELS ONLY — it must
#                             NOT contain a GA4 config tag or a Google Ads tag,
#                             or the property records duplicate sessions.
#
# Consent Mode v2 is region-scoped in code (EEA + UK + CH default to denied,
# everywhere else granted) — there is no NEXT_PUBLIC_CONSENT_DEFAULT any more.
# See src/lib/consent.js and src/components/analytics/AnalyticsScripts.jsx.
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-XXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-000000000
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
